        /// <summary>
        /// 1: Use Insertion Sort Algorithm to sort the array of integers in decreasing order.
        /// </summary>
        /// <param name="arr"></param>
        public static void InsertionSort_DecreasingOrder(int[] arr)
        {
            int n = arr.Length - 1;
            for (int i = 1; i <= n; i++)
            {
                for (int j = i; j > 0; j--)
                {
                    if (arr[j] > arr[j - 1])
                    {
                        int temp = arr[j];
                        arr[j] = arr[j - 1];
                        arr[j - 1] = temp;
                    }
                    else
                    {
                        break;
                    }
                }
            }

            foreach (var item in arr)
            {
                Console.WriteLine(item);
            }
            Console.ReadLine();
        }
