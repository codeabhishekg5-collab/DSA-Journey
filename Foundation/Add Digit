using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace DSA_Learning_Journey
{
    public class Program
    {
        static void Main(string[] args)
        {
            int num = 38;
            int response1 = AddDigitsBruteForce(num);
            int response2 = AddDigitsOptimizedCode(num);
            Console.WriteLine($"Brute Force Solution: {response1}.");  
            Console.WriteLine($"Full Optimized Solution: {response2}.");  
            Console.ReadLine(); 
        }

        /// <summary>
        /// This is the most optimized solution for Add digit question.
        /// </summary>
        /// <param name="num"></param>
        /// <returns></returns>
        public static int AddDigitsOptimizedCode(int num)
        {
            return 1 + ((num - 1) % 9);
        }

        /// <summary>
        /// This is the brute force way to solve Add digit question.
        /// </summary>
        /// <param name="num"></param>
        /// <returns></returns>
        public static int AddDigitsBruteForce(int num)
        {
            while (num > 9) {
                int sum = 0;
                while (num > 0) {
                    int rem = num % 10;
                    num /= 10;
                    sum += rem;
                }
                num = sum;
            }
            return num;
        }


    }
}

