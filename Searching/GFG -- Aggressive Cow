



public static int aggressiveCows(int[] stalls, int k)
{
    Array.Sort(stalls);
    int start = stalls[0], end, mid, ans = 0;
    end = stalls[stalls.Length - 1] - stalls[0];

    while (start <= end)
    {
        mid = start + (end - start) / 2;
        int count = 1, pos = stalls[0];
        for (int i = 0; i < stalls.Length - 1; i++)
        {
            if (pos + mid <= stalls[i])
            {
                count++;
                pos = stalls[i];
            }
        }
        if (count < k)
        {
            end = mid - 1;
        }
        else
        {
            ans = mid;
            start = mid + 1;
        }
    }
    return ans;
}
